#!/usr/bin/env bash
# Git `commit-msg` hook gating commits on a `Verified-by:` trailer.
# Installed ONLY by running `scripts/hooks/install.sh` explicitly.
#
# Modes (`VERIFY_GATE=off|observe|enforce`, default `observe`):
#   off      do nothing, exit 0
#   observe  log commits lacking a valid `Verified-by:` trailer to
#            .git/verify-gate.log and exit 0
#   enforce  refuse commits without a passing `Verified-by:` trailer unless the
#            message carries `Verified-by: none (reason: <why>)`; let the 3rd
#            consecutive attempt on the same HEAD through so an agent cannot get
#            stuck in an infinite commit loop.
set -uo pipefail

usage() {
    cat <<'EOF'
usage: scripts/hooks/commit-msg <commit-msg-file>
       scripts/hooks/commit-msg --self-test

Environment:
  VERIFY_GATE=off|observe|enforce     Gate mode (default: observe)
  VERIFY_GATE_LOG=<path>              Override .git/verify-gate.log path
  VERIFY_GATE_ATTEMPTS_FILE=<path>    Override .git/verify-gate.attempts path
EOF
}

# Evaluate a commit message file.
# Prints one of:
#   ok:verified
#   ok:none-with-reason
#   bad:missing
#   bad:none-without-reason
#   bad:failed-or-malformed
evaluate_msg_file() {
    local msg_file="$1"
    awk '
    function trim(s) {
        sub(/^[[:space:]]+/, "", s)
        sub(/[[:space:]]+$/, "", s)
        return s
    }
    /^# ------------------------ >8 ------------------------$/ { exit }
    /^#/ { next }
    /^[[:space:]]*[Vv]erified-by:[[:space:]]*/ {
        line = $0
        sub(/^[[:space:]]*[Vv]erified-by:[[:space:]]*/, "", line)
        stamp = trim(line)
        found = 1
    }
    END {
        if (!found || stamp == "") {
            print "bad:missing"
            exit
        }
        if (stamp == "none") {
            print "bad:none-without-reason"
            exit
        }
        if (stamp ~ /^none[[:space:]]*\(reason:[[:space:]]*[^[:space:])].*\)$/) {
            reason = stamp
            sub(/^none[[:space:]]*\(reason:[[:space:]]*/, "", reason)
            sub(/\)$/, "", reason)
            reason = trim(reason)
            if (reason != "" && reason != "..." && reason != "…" && reason != "<reason>") {
                print "ok:none-with-reason"
            } else {
                print "bad:none-without-reason"
            }
            exit
        }
        if (stamp ~ /^none([^a-zA-Z0-9_-]|$)/) {
            print "bad:none-without-reason"
            exit
        }
        n = split(stamp, toks, /[[:space:]]+/)
        passed = 0
        failed = 0
        malformed = 0
        for (i = 1; i <= n; i++) {
            t = toks[i]
            if (t == "") continue
            eq = index(t, "=")
            if (eq <= 1) {
                malformed = 1
                continue
            }
            val = substr(t, eq + 1)
            if (val == "pass" || val == "hostile") passed++
            else if (val == "fail") failed++
            else if (val == "skipped") { }
            else malformed = 1
        }
        if (failed > 0 || malformed > 0) {
            print "bad:failed-or-malformed"
        } else if (passed > 0) {
            print "ok:verified"
        } else {
            print "bad:none-without-reason"
        }
    }
    ' "$msg_file"
}

run_self_test() {
    local tmp
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/commit-msg-selftest.XXXXXX")
    trap 'rm -rf "$tmp"' RETURN

    local hook_dir hook_abs install_abs pass=0 fail=0
    hook_dir="$(cd "$(dirname "$0")" && pwd)"
    hook_abs="${hook_dir}/$(basename "$0")"
    install_abs="${hook_dir}/install.sh"

    echo "== commit-msg gate self-test =="
    local repo="$tmp/repo"
    git init -q "$repo"
    git -C "$repo" config user.email "test@veil.local"
    git -C "$repo" config user.name "Test"
    git -C "$repo" commit -q --allow-empty -m "initial"

    if [[ -f "$install_abs" ]]; then
        (cd "$repo" && bash "$install_abs" >/dev/null)
    else
        mkdir -p "$repo/.git/hooks"
        cp "$hook_abs" "$repo/.git/hooks/commit-msg"
        chmod +x "$repo/.git/hooks/commit-msg"
    fi

    # 1. Default (observe): unstamped commit succeeds and logs to .git/verify-gate.log
    if git -C "$repo" commit -q --allow-empty -m "unstamped in observe" &&
       [[ -f "$repo/.git/verify-gate.log" ]] &&
       grep -q 'mode=observe.*status=missing.*unstamped in observe' "$repo/.git/verify-gate.log"; then
        printf '  ok    observe mode allows unstamped commit and logs to .git/verify-gate.log\n'
        pass=$((pass + 1))
    else
        printf '  FAIL  observe mode test\n' >&2
        fail=$((fail + 1))
    fi

    # 2. Enforce mode: refuses 1st and 2nd consecutive attempts, allows 3rd through
    local rc1 rc2 rc3
    VERIFY_GATE=enforce git -C "$repo" commit -q --allow-empty -m "stuck agent commit" 2>/dev/null; rc1=$?
    VERIFY_GATE=enforce git -C "$repo" commit -q --allow-empty -m "stuck agent commit" 2>/dev/null; rc2=$?
    VERIFY_GATE=enforce git -C "$repo" commit -q --allow-empty -m "stuck agent commit" 2>/dev/null; rc3=$?
    if [[ "$rc1" -eq 1 && "$rc2" -eq 1 && "$rc3" -eq 0 ]] &&
       grep -q 'action=allowed-third-attempt' "$repo/.git/verify-gate.log"; then
        printf '  ok    enforce mode refuses attempts 1 & 2 and allows 3rd consecutive attempt\n'
        pass=$((pass + 1))
    else
        printf '  FAIL  enforce 3-attempt escape hatch (rc1=%d rc2=%d rc3=%d)\n' "$rc1" "$rc2" "$rc3" >&2
        fail=$((fail + 1))
    fi

    # 3. Enforce mode: bare `Verified-by: none` refused, `Verified-by: none (reason: ...)` allowed & resets counter
    local rc_bare rc_reason rc_after
    VERIFY_GATE=enforce git -C "$repo" commit -q --allow-empty -m $'bare none\n\nVerified-by: none' 2>/dev/null; rc_bare=$?
    VERIFY_GATE=enforce git -C "$repo" commit -q --allow-empty -m $'explained none\n\nVerified-by: none (reason: docs only)' 2>/dev/null; rc_reason=$?
    # Because `explained none` succeeded, counter reset: next unstamped attempt must fail again (attempt 1, not 3)
    VERIFY_GATE=enforce git -C "$repo" commit -q --allow-empty -m "after reset" 2>/dev/null; rc_after=$?
    if [[ "$rc_bare" -eq 1 && "$rc_reason" -eq 0 && "$rc_after" -eq 1 ]]; then
        printf '  ok    enforce mode requires (reason: ...) on none and resets attempt counter\n'
        pass=$((pass + 1))
    else
        printf '  FAIL  none-with-reason / counter reset (bare=%d reason=%d after=%d)\n' "$rc_bare" "$rc_reason" "$rc_after" >&2
        fail=$((fail + 1))
    fi

    # 4. Enforce mode: passing Verified-by trailer succeeds immediately
    if VERIFY_GATE=enforce git -C "$repo" commit -q --allow-empty -m $'tested change\n\nVerified-by: verify-fast=pass verify-server=skipped gate-1g=skipped load=skipped'; then
        printf '  ok    enforce mode accepts passing Verified-by trailer\n'
        pass=$((pass + 1))
    else
        printf '  FAIL  enforce mode rejected passing Verified-by trailer\n' >&2
        fail=$((fail + 1))
    fi

    echo "commit-msg gate self-test: $pass passed, $fail failed"
    [[ "$fail" -eq 0 ]]
}

if [[ "${1:-}" == "--self-test" ]]; then
    run_self_test
    exit $?
elif [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
fi

MSG_FILE="${1:-}"
if [[ -z "$MSG_FILE" || ! -f "$MSG_FILE" ]]; then
    echo "verify-gate: commit message file required" >&2
    exit 2
fi

MODE="${VERIFY_GATE:-}"
if [[ -z "$MODE" ]]; then
    MODE=$(git config --get veil.verifyGate 2>/dev/null || true)
    MODE="${MODE:-observe}"
fi
case "$MODE" in
    off) exit 0 ;;
    observe|enforce) ;;
    *)
        echo "verify-gate: invalid VERIFY_GATE='$MODE' (expected off, observe, or enforce)" >&2
        exit 2
        ;;
esac

LOG_FILE="${VERIFY_GATE_LOG:-$(git rev-parse --git-path verify-gate.log 2>/dev/null || echo ".git/verify-gate.log")}"
ATTEMPTS_FILE="${VERIFY_GATE_ATTEMPTS_FILE:-$(git rev-parse --git-path verify-gate.attempts 2>/dev/null || echo ".git/verify-gate.attempts")}"
HEAD_SHA=$(git rev-parse --short HEAD 2>/dev/null || echo "initial")
BRANCH=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo "detached")
SUBJECT=$(awk '/^#/{next} /^[[:space:]]*$/{next} {print; exit}' "$MSG_FILE" | cut -c1-100)
STAMP_NOW=$(date -u +%Y-%m-%dT%H:%M:%SZ)

VERDICT=$(evaluate_msg_file "$MSG_FILE")
case "$VERDICT" in
    ok:*)
        rm -f "$ATTEMPTS_FILE" 2>/dev/null || true
        exit 0
        ;;
esac

REASON_CODE="${VERDICT#bad:}"

if [[ "$MODE" == "observe" ]]; then
    printf '[%s] mode=observe action=logged branch=%s head=%s status=%s subject="%s"\n' \
        "$STAMP_NOW" "$BRANCH" "$HEAD_SHA" "$REASON_CODE" "$SUBJECT" >>"$LOG_FILE" 2>/dev/null || true
    exit 0
fi

# Enforce mode: count consecutive refused attempts on the same HEAD.
PREV_COUNT=0
PREV_HEAD=""
if [[ -f "$ATTEMPTS_FILE" ]]; then
    read -r PREV_COUNT PREV_HEAD <"$ATTEMPTS_FILE" 2>/dev/null || PREV_COUNT=0
    [[ "$PREV_COUNT" =~ ^[0-9]+$ ]] || PREV_COUNT=0
    if [[ "$PREV_HEAD" != "$HEAD_SHA" ]]; then
        PREV_COUNT=0
    fi
fi

ATTEMPT=$((PREV_COUNT + 1))

if ((ATTEMPT >= 3)); then
    rm -f "$ATTEMPTS_FILE" 2>/dev/null || true
    printf '[%s] mode=enforce action=allowed-third-attempt attempt=%d branch=%s head=%s status=%s subject="%s"\n' \
        "$STAMP_NOW" "$ATTEMPT" "$BRANCH" "$HEAD_SHA" "$REASON_CODE" "$SUBJECT" >>"$LOG_FILE" 2>/dev/null || true
    printf 'verify-gate: allowing 3rd consecutive attempt through (%s; logged to %s)\n' "$REASON_CODE" "$LOG_FILE" >&2
    exit 0
fi

printf '%d %s\n' "$ATTEMPT" "$HEAD_SHA" >"$ATTEMPTS_FILE" 2>/dev/null || true
printf '[%s] mode=enforce action=refused attempt=%d branch=%s head=%s status=%s subject="%s"\n' \
    "$STAMP_NOW" "$ATTEMPT" "$BRANCH" "$HEAD_SHA" "$REASON_CODE" "$SUBJECT" >>"$LOG_FILE" 2>/dev/null || true

cat >&2 <<EOF
verify-gate: commit refused (attempt ${ATTEMPT}/2; status: ${REASON_CODE}).
Add a verification trailer from the checks you ran:
  \$(scripts/verify-stamp.sh --fast-tag <tag>)
or, when no suite ran, state why explicitly:
  Verified-by: none (reason: <why no check ran>)
EOF
exit 1
