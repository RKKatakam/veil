# Copy to deploy/gcp/.env (ignored by git; chmod 600) and fill in. Every
# script in deploy/gcp reads it. Nothing here is ever committed or baked
# into an image, and no secret is: the credentials are a file's path.

# --- the project and its credentials ---
# The project id (not its name or number): Console > the project picker.
VEIL_GCP_PROJECT=
# Either a service account's key file (its path; chmod 600; the account
# needs roles/compute.admin on the project, and roles/viewer for
# preflight.sh's reads), or leave empty to use your active `gcloud auth login`.
VEIL_GCP_CREDENTIALS=
# The PostgreSQL password, only with VEIL_GCP_YB_NODES=0 (`openssl rand -hex 24`).
VEIL_GCP_DB_PASSWORD=

# --- who may reach the machines ---
# Your public IPv4 address: SSH and the balancer's port are open to it only
# (and to the run's own machines). `curl -4 -s https://ifconfig.me`
VEIL_GCP_OPERATOR_IP=

# --- topology (defaults shown; docs/DEPLOY.md §12) ---
VEIL_GCP_NAME=veil-test                 # name prefix, network tag and label (veil-run=NAME) of every resource
VEIL_GCP_REGION=us-central1
VEIL_GCP_ZONE=us-central1-a             # every machine in this one zone
VEIL_GCP_SPOT=hybrid                    # hybrid: servers, balancer, drivers on Spot; all; none
VEIL_GCP_SIZE_HUB=c2d-standard-16       # each server: 16 vCPUs, 64 GB
VEIL_GCP_HUBS=3                         # servers behind the balancer (1 to 3)
VEIL_GCP_SIZE_LB=e2-standard-4          # the balancer (HAProxy, TLS passed through)
VEIL_GCP_SIZE_DB=c2d-standard-8         # each YugabyteDB node (or PostgreSQL)
VEIL_GCP_YB_NODES=3                     # 0: PostgreSQL on one machine instead
VEIL_GCP_SIZE_DRIVER=c2d-standard-8     # each load driver
VEIL_GCP_DRIVERS=2
VEIL_GCP_SIZE_OBJECTS=c2d-standard-16   # the MinIO storage machine, with one 375 GB local NVMe SSD (dedicated vCPUs: no E2)
VEIL_GCP_WITH_CACHE=0                   # 1: a regional cache machine
VEIL_GCP_SIZE_CACHE=e2-standard-4
VEIL_GCP_DB_CONNECTIONS=64
# --- the database (docs/DEPLOY.md §12.10) ---
VEIL_GCP_YB_LAYOUT=colocated            # YugabyteDB: colocated (every table in one tablet) or hash
VEIL_GCP_YB_TABLETS=1                   # hash only: tablets per table on each node
VEIL_GCP_DB_DISK_TYPE=pd-ssd            # each database machine's data disk: pd-ssd or pd-balanced
VEIL_GCP_DB_DISK_GB=500                 # its size (pd-ssd: 30 IOPS and 0.48 MB/s a GB); 0: on the boot disk
VEIL_GCP_DISK_HUB=200                   # boot disks, GB (pd-balanced)
VEIL_GCP_DISK_DRIVER=100
VEIL_GCP_DISK_DB=100
VEIL_GCP_OBJECT_LAYOUT=                 # the servers' object layout: empty (the server's default), packs or objects (docs/HUB.md §13.42); each gate's run.txt records the one that ran
VEIL_GCP_HOURS=8                        # planned duration, for the estimate
