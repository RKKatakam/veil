# Copy to deploy/do/.env (ignored by git; chmod 600) and fill in. Every
# script in deploy/do reads it. Nothing here is ever committed or baked
# into an image.

# --- secrets (from the DigitalOcean control panel) ---
# A personal access token with read and write scope: API > Tokens.
VEIL_DO_TOKEN=
# A Spaces access key pair: API > Spaces Keys. The server uses them to read
# and write objects; destroy.sh uses them to empty and delete the bucket.
VEIL_DO_SPACES_KEY=
VEIL_DO_SPACES_SECRET=
# The PostgreSQL password the database droplet is started with (any long
# random string: `openssl rand -hex 24`).
VEIL_DO_DB_PASSWORD=

# --- who may reach the machines ---
# Your public IPv4 address: SSH and the server's port are open to it only
# (and to the test's own droplets). `curl -4 -s https://ifconfig.me`
VEIL_DO_OPERATOR_IP=

# --- topology (defaults shown; docs/DEPLOY.md "Topology and cost") ---
VEIL_DO_NAME=veil-test          # prefix and tag of every resource
VEIL_DO_REGION=nyc3             # droplets and the Spaces bucket (one region)
VEIL_DO_SIZE_HUB=c-16           # the server: 16 dedicated vCPUs, 32 GB
VEIL_DO_SIZE_DB=c-8             # PostgreSQL 17 in a container (or each YugabyteDB node)
VEIL_DO_SIZE_DRIVER=c-8         # each load driver
VEIL_DO_DRIVERS=2               # load drivers
VEIL_DO_HUBS=1                  # 2 or 3: servers on the one database and bucket, behind a balancer (the full run: 3)
VEIL_DO_SIZE_LB=c-4             # the balancer droplet (HAProxy, TLS passed through), with 2 or 3 servers
VEIL_DO_YB_NODES=0              # 3: a three-node YugabyteDB cluster instead of PostgreSQL (the full run: 3)
VEIL_DO_DB_CONNECTIONS=64       # database connections of each server
VEIL_DO_WITH_CACHE=0            # 1: a regional cache droplet (for vl clients; see docs/DEPLOY.md)
VEIL_DO_SIZE_CACHE=s-4vcpu-8gb
VEIL_DO_HOURS=8                 # planned duration, for the estimate
VEIL_DO_BUCKET=                 # Spaces bucket (default: NAME-objects-<random>, unique per region)
