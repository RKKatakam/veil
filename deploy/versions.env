# The third-party images of a Veil deployment, pinned by digest. Sourced by
# deploy/do/lib.sh and deploy/compose/rehearsal.sh, so the paid run and the
# free rehearsal run the same versions (docs/REPRODUCE.md lists them).
# The server and benchmark images are built from this checkout
# (deploy/docker/Dockerfile pins its own base images by digest).
PG_IMAGE=postgres:17-alpine@sha256:5d9ee39acd134b44f52fc49ca3b88fc651f0560b0db93292fcd37ff150c71d3a
YB_IMAGE=yugabytedb/yugabyte:2025.2.8.1-b8@sha256:98a1d6ab0076f3d2192f586aa5f8edbfb967d802ad6a495e45f47d2dfe3ef588
# HAProxy 3.0.30: the balancer in front of several servers (TCP, TLS passed through).
HAPROXY_IMAGE=haproxy:3.0-alpine@sha256:d2b3567d836f3b7d174edb6d6f611ed5308e7966e53a9cd9a597e0415a298efd
# MinIO stands in for Spaces in the rehearsal only (MinIO no longer
# publishes images on Docker Hub; this is the server as Bitnami last packaged it).
MINIO_IMAGE=bitnamilegacy/minio:latest@sha256:451fe6858cb770cc9d0e77ba811ce287420f781c7c1b806a386f6896471a349c
